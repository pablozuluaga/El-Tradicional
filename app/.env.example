# Leave both empty to run fully in the browser (demo mode: the customer tab and /admin
# sync on the same device only). Set both to use Supabase; see supabase/schema.sql for setup.
VITE_SUPABASE_URL=
# Project's publishable key (sb_publishable_…) or legacy anon key; safe to ship in the client.
# VITE_SUPABASE_ANON_KEY also works.
VITE_SUPABASE_PUBLISHABLE_KEY=
